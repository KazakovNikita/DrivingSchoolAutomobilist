<Page x:Class="Autoshkola.InstructorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Autoshkola"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="1000"
      Title="InstructorPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Расписание занятий" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"></TextBlock>
        <TextBlock Text="Поиск:" Grid.Row="1" HorizontalAlignment="Left" Margin="10 0 0 0"></TextBlock>
        <TextBox Width="100" Grid.Row="1" Margin="60 0 0 0" MaxLength="50" Name="tbSearch" TextChanged="tbSearch_TextChanged" ToolTip="Введите группу для поиска"></TextBox>
        <DataGrid Grid.Row="2" x:Name="dGridHistory" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Группа" Binding="{Binding Id}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Категория обучения" Binding="{Binding Groups.Category}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Смена 1" Binding="{Binding Change1}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Смена 2" Binding="{Binding Change2}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Смена 3" Binding="{Binding Change3}" Width="*"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
      
        <Button Content="Печать" Grid.Row="3" HorizontalAlignment="Right" Name="btnPrint" Click="btnPrint_Click"></Button>

        <TextBlock Text="Вы вошли под инструктором" Margin="330 0 0 0" VerticalAlignment="Center" FontSize="10" Grid.Row="3" ></TextBlock>
        <Button Content="План обучения" Grid.Row="3"  HorizontalAlignment="Center" Name="btnAdd" Click="btnAdd_Click"></Button>

    </Grid>
</Page>
