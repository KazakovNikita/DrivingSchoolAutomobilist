<Page x:Class="Autoshkola.AutorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Autoshkola"
      mc:Ignorable="d" 
      d:DesignHeight="300" d:DesignWidth="300"
      Title="AutorizationPage" Focusable="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <TextBlock>Авторизация</TextBlock>
        </Grid>
        <Grid Grid.Row="1">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" >Логин:</TextBlock>
            <TextBox Width="130" HorizontalAlignment="Center" VerticalAlignment="Bottom" Name="boxLog" ></TextBox>
        </Grid>
        <Grid Grid.Row="2">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" >Пароль:</TextBlock>
            <PasswordBox MaxLength="20" Width="130" HorizontalAlignment="Center" VerticalAlignment="Bottom" Name="boxPass"></PasswordBox>
            <TextBox Name="tbPass" Width="130" Height="22" Margin="10 -22 0 0"  Visibility="Hidden"></TextBox>
        </Grid>
        <Grid Grid.Row="3">
            <Button HorizontalAlignment="Center" VerticalAlignment="Top" Content="Войти" Name="btnLogin" Click="btnLogin_Click"></Button>
        </Grid>

    </Grid>
</Page>
