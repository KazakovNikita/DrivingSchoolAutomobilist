<Page x:Class="Autoshkola.AddUsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Autoshkola"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddUsersPage" Focusable="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="53*"/>
            <ColumnDefinition Width="107*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Имя" ></TextBlock>
        <TextBlock Text="Фамилия" Grid.Row="1"></TextBlock>
        <TextBlock Text="Логин" Grid.Row="2" ></TextBlock>
        <TextBlock Text="Пароль" Grid.Row="3" ></TextBlock>
        <TextBlock Text="Роль" Grid.Row="4" ></TextBlock>
        <TextBox Text="{Binding Name}" Grid.Column="1" ></TextBox>
        <TextBox Text="{Binding LastName}" Grid.Column="1" Grid.Row="1" ></TextBox>
        <TextBox Text="{Binding Login}" Grid.Column="1" Grid.Row="2" ></TextBox>
        <TextBox Text="{Binding Password}" MaxLength="20" Grid.Column="1" Grid.Row="3" ></TextBox>
        <ComboBox SelectedItem="{Binding UsersRoles}" DisplayMemberPath="Title" Grid.Column="1" Grid.Row="4" Name="cbRole" ></ComboBox>
        <Button Content="Сохранить" Grid.Column="1" Grid.Row="5" Name="btnSave" Click="btnSave_Click"></Button>
        <Button Content="Отмена" Grid.ColumnSpan="2"  HorizontalAlignment="Right" Grid.Row="5" Name="btnCancel" Click="btnCancel_Click"></Button>
    </Grid>
</Page>
