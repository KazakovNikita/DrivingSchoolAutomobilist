<Page x:Class="Autoshkola.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Autoshkola"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="1000"
      Title="AdminPage" Focusable="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <TextBlock Text="История входа" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"></TextBlock>
        <TextBlock Text="Поиск:" Grid.Row="1" HorizontalAlignment="Left" Margin="10 0 0 0"></TextBlock>
        <TextBox Width="100" Grid.Row="1" Margin="60 0 0 0" MaxLength="50" Name="tbSearch" TextChanged="tbSearch_TextChanged"></TextBox>
        <DataGrid Grid.Row="2" x:Name="dGridHistory" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Логин" Binding="{Binding Users.Login}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Последний вход" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="*"></DataGridTextColumn>
                <DataGridTextColumn Header="Статус входа" Binding="{Binding Status}" Width="*"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="Очистить" Grid.Row="3" HorizontalAlignment="Left" Name="btnClear" Click="btnClear_Click"></Button>
        <Button Content="Печать" Grid.Row="3" HorizontalAlignment="Right" Name="btnPrint" Click="btnPrint_Click"></Button>
        
        <TextBlock Text="Вы вошли под администратором" Margin="330 0 0 0" VerticalAlignment="Center" FontSize="10" Grid.Row="3" ></TextBlock>
        <Button Content="Добавить пользов." Grid.Row="3"  HorizontalAlignment="Center" Name="btnAdd" Click="btnAdd_Click"></Button>
  
    </Grid>
</Page>
