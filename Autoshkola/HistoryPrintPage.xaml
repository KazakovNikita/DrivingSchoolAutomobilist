<Page x:Class="Autoshkola.HistoryPrintPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Autoshkola"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HistoryPrintPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DocumentViewer Name="documentviewer">
            <FixedDocument>
                <PageContent>
                    <FixedPage>
                        <Grid Margin="10" Width="450" Height="800">
                            <DataGrid Grid.Row="2" x:Name="dGridHistoryPrint" AutoGenerateColumns="False" IsReadOnly="True" Height="900">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Пользователь" Binding="{Binding Users.Id}" Width="*"></DataGridTextColumn>
                                    <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="*"></DataGridTextColumn>
                                    <DataGridTextColumn Header="Статус входа" Binding="{Binding Status}" Width="*"></DataGridTextColumn>
                                   
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </FixedPage>
                </PageContent>
            </FixedDocument>
        </DocumentViewer>

    </Grid>
</Page>
